{% extends "base.njk" %}
{% block head %}<style>
.f-hero{position:relative;background:var(--navy);color:var(--on-navy);overflow:hidden}
.f-hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(24px,4vw,56px);align-items:end;padding-top:clamp(48px,7vw,80px)}
.f-hero h1{color:#fff}
.f-hero .txt{padding-bottom:clamp(48px,7vw,90px);display:grid;gap:16px;position:relative;z-index:1}
.f-hero .portrait{position:relative;align-self:stretch;min-height:420px}
.f-hero .portrait img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:60% 22%;border-radius:24px 24px 0 0;animation:fadeUp 1s var(--ease) .2s both}
.f-hero .portrait::after{content:"";position:absolute;inset:0;border-radius:24px 24px 0 0;background:linear-gradient(transparent 60%,rgba(11,37,69,.6))}
.f-hero .portrait .cap{position:absolute;left:16px;bottom:16px;z-index:1;font:500 11px var(--f-mono);letter-spacing:.05em;color:#fff;background:rgba(11,37,69,.7);padding:5px 10px;border-radius:99px}
.roles{display:flex;flex-wrap:wrap;gap:8px}
.roles span{border:1px solid rgba(255,255,255,.2);border-radius:99px;padding:6px 12px;font-size:13px;color:var(--on-navy)}
@media (max-width:860px){.f-hero .wrap{grid-template-columns:1fr}.f-hero .txt{padding-bottom:0}.f-hero .portrait{min-height:320px}}
.career{display:grid;gap:0;position:relative}
.cr{display:grid;grid-template-columns:180px 26px 1fr;gap:16px;align-items:start;padding-bottom:30px;position:relative}
.cr .when{font:500 12px var(--f-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--teal);padding-top:4px;text-align:right}
.cr .dot{width:14px;height:14px;border-radius:50%;border:3px solid var(--teal);background:var(--bg);margin:5px auto 0;position:relative;z-index:1}
.cr::before{content:"";position:absolute;left:calc(180px + 16px + 12px);top:18px;bottom:-4px;width:2px;background:var(--line)}
.cr:last-child::before{display:none}
.cr h3{font-size:19px}
.cr .org{font-weight:600;color:var(--navy);font-size:15px;margin:2px 0 6px}
.cr p{color:var(--muted);font-size:15px;max-width:60ch}
@media (max-width:640px){.cr{grid-template-columns:22px 1fr}.cr .when{grid-column:2;text-align:left;padding:0}.cr .dot{grid-row:1/3;grid-column:1}.cr>div:last-child{grid-column:2}.cr::before{left:10px}}
.societies{display:flex;flex-wrap:wrap;gap:10px}
.societies span{background:var(--surface);border:1px solid var(--line);border-radius:99px;padding:8px 14px;font-size:14px;color:var(--navy);transition:border-color var(--fast),transform var(--fast) var(--ease)}
.societies span:hover{border-color:var(--teal);transform:translateY(-2px)}
.talk{display:grid;gap:6px}
.talk .mono{color:var(--teal)}
</style>{% endblock %}
{% block main %}
<main id="main">

<section class="f-hero on-dark">
  <div class="wrap">
    <div class="txt">
      <span class="crumbs load-in"><a href="index.html">Home</a> / Founder</span>
      <span class="kicker load-in" style="--d:.05s">Founder &amp; President</span>
      <h1 class="h-xl load-in" style="--d:.1s">Prof. Medhat Shalabi</h1>
      <p class="lede load-in" style="--d:.18s">Consultant anaesthetist and ERAS implementation expert. Trained in Alexandria and the UK, he has practised on three continents and advises hospital teams across the GCC, the Middle East, Africa, Asia and Europe.</p>
      <div class="roles load-in" style="--d:.26s"><span>Founder, PAME ERAS</span><span>Vice President, World SIVA</span><span>FRCA</span><span>Emeritus Professor, Alexandria University</span></div>
      <div class="load-in" style="--d:.34s;display:flex;gap:12px;flex-wrap:wrap;margin-top:6px"><a class="btn btn-pri" href="contact.html?topic=speaker">Invite him to speak</a><a class="btn btn-ghost" href="about.html#welcome">Read his welcome letter</a></div>
    </div>
    <div class="portrait"><img src="img/founder-tv.jpg" alt="Prof. Medhat Shalabi"><span class="cap">Alaan TV interview</span></div>
  </div>
</section>

<section class="sec">
  <div class="wrap split" style="align-items:start">
    <div class="sec-head reveal" style="position:sticky;top:110px"><span class="kicker">Career</span><h2 class="h-lg">From Alexandria to three continents.</h2><p class="lede">Training in Egypt and the UK, consultant practice in the NHS, and leadership roles in Dubai.</p></div>
    <div class="career stagger">
      <div class="cr"><span class="when">Foundation</span><span class="dot"></span><div><h3>MB BCh, MSc and MD in Anesthesiology</h3><div class="org">Alexandria University, Egypt</div><p>MD thesis on acute pain management, jointly supervised with the University of Manchester. University staff member, later Emeritus Professor.</p></div></div>
      <div class="cr"><span class="when">UK training</span><span class="dot"></span><div><h3>Senior House Officer to Specialist Registrar</h3><div class="org">Merseyside (Liverpool) Deanery</div><p>The full UK training scheme. Diploma in Anaesthesia, FRCA, CCST and GMC specialist registration.</p></div></div>
      <div class="cr"><span class="when">10+ years</span><span class="dot"></span><div><h3>Consultant Anaesthetist</h3><div class="org">NHS, United Kingdom</div><p>Consultant practice including many years as a pain management consultant. Member of a UK Research Ethics Committee.</p></div></div>
      <div class="cr"><span class="when">Dubai</span><span class="dot"></span><div><h3>Head of Anesthesiology &amp; Intensive Care</h3><div class="org">Al Zahra Hospital</div><p>Led the anaesthesia and intensive care department.</p></div></div>
      <div class="cr"><span class="when">Dubai · c. 2021</span><span class="dot"></span><div><h3>Head of Perioperative Clinical Directorate</h3><div class="org">Fakeeh University Hospital</div><p>Perioperative services with a focus on operating room efficiency, capacity and outcomes.</p></div></div>
      <div class="cr"><span class="when">Current · 2025</span><span class="dot"></span><div><h3>Consultant Anaesthetist &amp; ERAS Implementation Expert</h3><div class="org">NHS, United Kingdom</div><p>Returned to UK practice while continuing to lead PAME ERAS and advise internationally.</p></div></div>
    </div>
  </div>
</section>

<section class="sec sec-sand">
  <div class="wrap">
    <div class="sec-head reveal"><span class="kicker">Clinical interests</span><h2 class="h-lg">Where he focuses.</h2></div>
    <div class="grid g4 stagger">
      <div class="card lift"><h3>ERAS implementation</h3><p>Multidisciplinary programmes and the audit that sustains them.</p></div>
      <div class="card lift"><h3>TIVA &amp; TCI</h3><p>Total intravenous anaesthesia and target-controlled infusion.</p></div>
      <div class="card lift"><h3>Safety &amp; clinical risk</h3><p>Risk management, surgical safety and clinical ethics.</p></div>
      <div class="card lift"><h3>Acute pain</h3><p>The subject of his MD research.</p></div>
      <div class="card lift"><h3>Obstetric anaesthesia</h3><p>Labour analgesia and caesarean delivery.</p></div>
      <div class="card lift"><h3>Orthopaedics &amp; trauma</h3><p>Anaesthesia for orthopaedic and trauma surgery.</p></div>
      <div class="card lift"><h3>Day-case surgery</h3><p>Anaesthesia that gets patients home the same day.</p></div>
      <div class="card lift"><h3>Value-based care</h3><p>Linking pathways to theatre efficiency and financial outcomes.</p></div>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap split" style="align-items:start">
    <div>
      <div class="sec-head reveal"><span class="kicker">Speaking</span><h2 class="h-lg">A regular voice at ERAS meetings.</h2></div>
      <div class="grid stagger">
        <div class="card talk"><span class="mono">Abu Dhabi · September 2025</span><h3>The Safe Brain Initiative: preventing injury, enhancing recovery</h3><p>ERAS and regional anaesthesia session, Abu Dhabi Annual Anesthesia Congress.</p></div>
        <div class="card talk"><span class="mono">Türkiye · 2018</span><h3>Invited speaker, 1st ERAS Congress of Türkiye</h3><p>International faculty alongside Prof. Henrik Kehlet and ERAS® Society co-founder Prof. Olle Ljungqvist.</p></div>
        <div class="card talk"><span class="mono">Alaan TV</span><h3>Steps to enhanced recovery after surgery</h3><p><a class="link-arrow" href="education.html">Watch the interview</a></p></div>
      </div>
    </div>
    <div>
      <div class="sec-head reveal"><span class="kicker">Invited by</span><h2 class="h-md">Societies and congresses</h2></div>
      <div class="societies stagger">
        <span>Egyptian Anesthesiology Society</span><span>Alexandria Anesthesia &amp; Intensive Care Society</span><span>Pan Arab Anesthesia Society</span><span>All Africa Anesthesia Society</span><span>Emirates Critical Care Society</span><span>Asia Africa Critical Care Society</span><span>International Pan Arab Critical Care Medicine Society</span><span>Iranian Anesthesiology &amp; Intensive Care Society</span><span>Turkish Anesthesiology &amp; Intensive Care Society</span><span>World Congress of Anaesthesiologists</span>
      </div>
      <p class="note" style="margin-top:22px">Profile compiled from public sources for his personal page. Needs Prof. Shalabi's confirmation before publishing. The year of the Türkiye congress is matched to the photo archive.</p>
    </div>
  </div>
</section>

<section class="sec sec-navy on-dark">
  <div class="wrap" style="text-align:center;display:grid;gap:18px;justify-items:center">
    <h2 class="h-lg reveal">Speaking invitations and implementation enquiries.</h2>
    <p class="lede reveal">For congresses, hospital ERAS programmes and teaching, send a short note with your dates and goals.</p>
    <a class="btn btn-pri reveal" href="contact.html?topic=speaker">Get in touch</a>
  </div>
</section>

</main>
